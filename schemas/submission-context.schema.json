{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitl-protocol.org/schemas/v0.9/submission-context.json",
  "title": "Submission Context",
  "description": "Context about how a completed HITL review was submitted in v0.9.",
  "oneOf": [
    {
      "title": "BrowserSubmissionContext",
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "const": "browser_submit"
        },
        "submitted_via": {
          "type": "string",
          "description": "Audit string describing the submission channel or surface."
        },
        "submitted_by": {
          "type": "object",
          "required": [
            "platform",
            "platform_user_id"
          ],
          "properties": {
            "platform": {
              "type": "string",
              "description": "Platform or surface identifier."
            },
            "platform_user_id": {
              "type": "string",
              "description": "Platform-specific user identifier."
            },
            "display_name": {
              "type": "string",
              "description": "Human-readable display name if known."
            }
          },
          "additionalProperties": false,
          "description": "Submission origin metadata for inline-path auditability."
        },
        "verification_result": {
          "$ref": "verification-result.json",
          "description": "Normalized outcome of the service-side verification flow."
        }
      },
      "additionalProperties": false
    },
    {
      "title": "InlineSubmissionContext",
      "type": "object",
      "required": [
        "mode",
        "submitted_via",
        "submitted_by"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "const": "inline_submit"
        },
        "submitted_via": {
          "type": "string",
          "description": "Audit string describing the submission channel or surface."
        },
        "submitted_by": {
          "type": "object",
          "required": [
            "platform",
            "platform_user_id"
          ],
          "properties": {
            "platform": {
              "type": "string",
              "description": "Platform or surface identifier."
            },
            "platform_user_id": {
              "type": "string",
              "description": "Platform-specific user identifier."
            },
            "display_name": {
              "type": "string",
              "description": "Human-readable display name if known."
            }
          },
          "additionalProperties": false,
          "description": "Submission origin metadata for inline-path auditability."
        },
        "verification_result": {
          "$ref": "verification-result.json",
          "description": "Normalized outcome of the service-side verification flow."
        }
      },
      "additionalProperties": false
    }
  ]
}
