{
  "name": "@hitl-protocol/core",
  "version": "0.1.0",
  "description": "Core utilities for HITL Protocol \u2014 tokens, state machine, rate limiting",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "hitl",
    "hitl-protocol",
    "human-in-the-loop",
    "state-machine",
    "token",
    "agent",
    "review"
  ],
  "homepage": "https://github.com/rotorstar/hitl-protocol",
  "repository": {
    "type": "git",
    "url": "https://github.com/rotorstar/hitl-protocol.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/rotorstar/hitl-protocol/issues"
  },
  "license": "Apache-2.0",
  "author": "Torsten Heissler",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hitl-protocol/schemas": "workspace:*",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "vite": "8.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
