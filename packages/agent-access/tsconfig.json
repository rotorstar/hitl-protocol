{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "types": ["node"], "declaration": true, "declarationMap": true,
    "outDir": "dist", "rootDir": "src", "esModuleInterop": true,
    "skipLibCheck": true, "noUncheckedIndexedAccess": true, "noImplicitReturns": true
  },
  "include": ["src"], "exclude": ["dist", "node_modules"]
}
