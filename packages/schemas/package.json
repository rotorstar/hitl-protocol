{
  "name": "@hitl-protocol/schemas",
  "version": "0.8.0",
  "description": "JSON Schemas, TypeScript types, and validators for the HITL Protocol",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hitl-object.schema.json": "./schemas/hitl-object.schema.json",
    "./poll-response.schema.json": "./schemas/poll-response.schema.json",
    "./form-field.schema.json": "./schemas/form-field.schema.json",
    "./submit-request.schema.json": "./schemas/submit-request.schema.json",
    "./discovery-response.schema.json": "./schemas/discovery-response.schema.json",
    "./verification-policy.schema.json": "./schemas/verification-policy.schema.json",
    "./verification-result.schema.json": "./schemas/verification-result.schema.json",
    "./submission-context.schema.json": "./schemas/submission-context.schema.json",
    "./v0.8": {
      "types": "./dist/v0.8.d.ts",
      "import": "./dist/v0.8.js"
    },
    "./v0.9": {
      "types": "./dist/v0.9.d.ts",
      "import": "./dist/v0.9.js"
    },
    "./v0.8/hitl-object.schema.json": "./schemas/v0.8/hitl-object.schema.json",
    "./v0.8/poll-response.schema.json": "./schemas/v0.8/poll-response.schema.json",
    "./v0.8/form-field.schema.json": "./schemas/v0.8/form-field.schema.json",
    "./v0.8/submit-request.schema.json": "./schemas/v0.8/submit-request.schema.json",
    "./v0.8/discovery-response.schema.json": "./schemas/v0.8/discovery-response.schema.json",
    "./v0.8/verification-policy.schema.json": "./schemas/v0.8/verification-policy.schema.json",
    "./v0.8/verification-result.schema.json": "./schemas/v0.8/verification-result.schema.json",
    "./v0.8/submission-context.schema.json": "./schemas/v0.8/submission-context.schema.json",
    "./v0.9/hitl-object.schema.json": "./schemas/v0.9/hitl-object.schema.json",
    "./v0.9/poll-response.schema.json": "./schemas/v0.9/poll-response.schema.json",
    "./v0.9/form-field.schema.json": "./schemas/v0.9/form-field.schema.json",
    "./v0.9/submit-request.schema.json": "./schemas/v0.9/submit-request.schema.json",
    "./v0.9/discovery-response.schema.json": "./schemas/v0.9/discovery-response.schema.json",
    "./v0.9/verification-policy.schema.json": "./schemas/v0.9/verification-policy.schema.json",
    "./v0.9/verification-result.schema.json": "./schemas/v0.9/verification-result.schema.json",
    "./v0.9/submission-context.schema.json": "./schemas/v0.9/submission-context.schema.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "prebuild": "pnpm run generate",
    "pretest": "pnpm run generate",
    "build": "tsup && tsc --emitDeclarationOnly --project tsconfig.build.json",
    "test": "vitest run",
    "generate": "node scripts/copy-schemas.js && node scripts/generate-types.js",
    "typecheck": "tsc --noEmit",
    "test:pack": "node scripts/verify-pack.mjs",
    "generate:profile": "node scripts/generate-profile.js",
    "check:profile": "node scripts/generate-profile.js --check"
  },
  "keywords": [
    "hitl",
    "hitl-protocol",
    "human-in-the-loop",
    "json-schema",
    "agent",
    "review",
    "approval",
    "workflow"
  ],
  "homepage": "https://github.com/rotorstar/hitl-protocol",
  "repository": {
    "type": "git",
    "url": "https://github.com/rotorstar/hitl-protocol.git",
    "directory": "packages/schemas"
  },
  "bugs": {
    "url": "https://github.com/rotorstar/hitl-protocol/issues"
  },
  "license": "Apache-2.0",
  "author": "Torsten Heissler",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "json-schema-to-typescript": "16.0.0",
    "vite": "8.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
